<Window x:Class="WindowsNotch.UI.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WindowsNotch.UI"
        Title="FreeNotch"
        Width="700" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Standard Button -->
        <Style x:Key="NotchButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1C1C22" CornerRadius="10" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabActiveBg}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#282830" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.085" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.085" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kompakte Icon-Toolbar Buttons (Kreis-Pill wie Notchify) -->
        <Style x:Key="NotchIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabActiveBg}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabActiveBg}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.91" Duration="0:0:0.085" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.91" Duration="0:0:0.085" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modul-Icon-Tab (Notchify Icon-Only Navigation) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.91" Duration="0:0:0.085" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.91" Duration="0:0:0.085" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabActiveBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Transparenter Container: Klicks außerhalb der Notch gehen zum Desktop durch -->
    <Grid ClipToBounds="True">
        <Grid x:Name="NotchBorder"
              Width="196" Height="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              UseLayoutRounding="False"
              AllowDrop="True"
              DragEnter="Notch_DragEnter"
              DragOver="Notch_DragOver"
              Drop="Notch_Drop"
              MouseEnter="Notch_MouseEnter"
              MouseLeave="Notch_MouseLeave"
              MouseLeftButtonUp="Notch_MouseLeftButtonUp">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="NotchSuppressTransform" X="0" Y="0" />
            </Grid.RenderTransform>

            <!-- Konkave Notch-Silhouette (OLED-Schwarz + Schatten, kein harter Kastenrahmen) -->
            <Path x:Name="NotchShellPath"
                  Fill="#000000"
                  StrokeThickness="0"
                  IsHitTestVisible="True">
                <Path.Effect>
                    <DropShadowEffect x:Name="NotchShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000" RenderingBias="Performance" />
                </Path.Effect>
            </Path>

            <!-- Geclippter Inhaltsbereich innerhalb der Notch-Silhouette -->
            <Grid x:Name="NotchContentHost" ClipToBounds="True">
                <!-- Maskottchen-Overlay im eingeklappten Ruhezustand (neben Uhrzeit/Inhalt) -->
                <ContentControl x:Name="PetOverlayHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="14,0,14,0"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />

                <!-- Kapsel-Vorschau im Hover-Zustand & Live-Activity -->
                <ContentControl x:Name="PreviewHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0"
                                IsHitTestVisible="True"
                                Margin="16,0,16,0" />

                <!-- Dezente Status-LEDs oben rechts (Rot = Bildschirmaufnahme, Grün = Kamera) -->
                <StackPanel x:Name="PrivacyIndicatorPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,7,18,0"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                    <Ellipse x:Name="RecordingStatusDot"
                             Width="6.5" Height="6.5"
                             Visibility="Collapsed">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF453A" BlurRadius="6" ShadowDepth="0" Opacity="0.75" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="CameraStatusDot"
                             Width="6.5" Height="6.5"
                             Visibility="Collapsed">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.75" />
                        </Ellipse.Effect>
                    </Ellipse>
                </StackPanel>

                <!-- Geöffnete Notch (Expanded State) -->
                <Grid x:Name="ExpandedPanel"
                      Opacity="0"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="0.97" ScaleY="0.97" />
                            <TranslateTransform x:Name="ExpandedTranslate" Y="-4" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Notchify Icon-Only Kopfleiste (ohne Trennlinie) -->
                    <Grid x:Name="ExpandedHeaderGrid" Grid.Row="0" Margin="26,10,26,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel x:Name="TabContainer" Orientation="Horizontal" VerticalAlignment="Center" />
                        </ScrollViewer>

                        <!-- Einstellungen & kontextuelles Schließen (bei KeepExpanded-Modulen wie File Tray) rechts außen -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="SettingsBtn"
                                    Style="{StaticResource NotchIconButton}"
                                    ToolTip="{ui:Loc notch.settings_tooltip}"
                                    Click="Settings_Click">
                                <Path x:Name="SettingsIconPath"
                                      Data="M 12,15 A 3,3 0 1 1 12,9 A 3,3 0 1 1 12,15 Z M 19.4,15 A 1.65,1.65 0 0 0 19.73,16.82 L 19.79,16.88 A 2,2 0 1 1 16.96,19.71 L 16.9,19.65 A 1.65,1.65 0 0 0 15.08,19.32 A 1.65,1.65 0 0 0 14,20.83 L 14,21 A 2,2 0 1 1 10,21 L 10,20.91 A 1.65,1.65 0 0 0 8.92,19.4 A 1.65,1.65 0 0 0 7.1,19.73 L 7.04,19.79 A 2,2 0 1 1 4.21,16.96 L 4.27,16.9 A 1.65,1.65 0 0 0 4.6,15.08 A 1.65,1.65 0 0 0 3.09,14 L 3,14 A 2,2 0 1 1 3,10 L 3.09,10 A 1.65,1.65 0 0 0 4.6,8.92 A 1.65,1.65 0 0 0 4.27,7.1 L 4.21,7.04 A 2,2 0 1 1 7.04,4.21 L 7.1,4.27 A 1.65,1.65 0 0 0 8.92,4.6 L 9,4.6 A 1.65,1.65 0 0 0 10,3.09 L 10,3 A 2,2 0 1 1 14,3 L 14,3.09 A 1.65,1.65 0 0 0 15.08,4.6 A 1.65,1.65 0 0 0 16.9,4.27 L 16.96,4.21 A 2,2 0 1 1 19.79,7.04 L 19.73,7.1 A 1.65,1.65 0 0 0 19.4,8.92 L 19.4,9 A 1.65,1.65 0 0 0 20.91,10 L 21,10 A 2,2 0 1 1 21,14 L 20.91,14 A 1.65,1.65 0 0 0 19.4,15 Z"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TabForeground}"
                                      StrokeThickness="1.75"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                            <Button x:Name="CloseBtn"
                                    Style="{StaticResource NotchIconButton}"
                                    ToolTip="{ui:Loc notch.close_tooltip}"
                                    Margin="4,0,0,0"
                                    Visibility="Collapsed"
                                    Click="Close_Click">
                                <Viewbox Width="14" Height="14" Stretch="Uniform">
                                    <Grid Width="24" Height="24">
                                        <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                              Stroke="{DynamicResource TabForeground}"
                                              StrokeThickness="2.15"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Host-Bereich für CreateExpandedView() des gewählten Moduls -->
                    <ContentControl x:Name="ExpandedHost"
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Margin="26,2,26,18" />

                    <!-- Kompaktes OLED-Steuerband für die Live-Tab-Tour (Onboarding Teil 2) -->
                    <ContentControl x:Name="TourBarHost"
                                    Grid.Row="2"
                                    Visibility="Collapsed"
                                    Margin="26,0,26,14" />

                    <!-- Fallback falls keine Module aktiv sind -->
                    <StackPanel x:Name="EmptyModulesPanel"
                                Grid.Row="1"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{ui:Loc notch.no_modules}"
                                   Foreground="{DynamicResource TabActiveForeground}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <Button Content="{ui:Loc notch.open_settings}"
                                Style="{StaticResource NotchButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Click="Settings_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
